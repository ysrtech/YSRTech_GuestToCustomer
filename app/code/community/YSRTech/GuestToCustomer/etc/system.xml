<?xml version="1.0"?>
<!--
/**
 * System configuration for YSRTech_GuestToCustomer.
 *
 * Adds a "YSRTech" tab to System > Configuration with an enable/disable
 * toggle and a toggle for each linking trigger.
 */
-->
<config>
    <tabs>
        <ysrtech translate="label" module="ysrtech_guesttocustomer">
            <label>YSRTech</label>
            <sort_order>400</sort_order>
        </ysrtech>
    </tabs>

    <sections>
        <ysrtech_guesttocustomer translate="label" module="ysrtech_guesttocustomer">
            <label>Guest To Customer</label>
            <tab>ysrtech</tab>
            <frontend_type>text</frontend_type>
            <sort_order>10</sort_order>
            <show_in_default>1</show_in_default>
            <show_in_website>1</show_in_website>
            <show_in_store>0</show_in_store>
            <groups>
                <general translate="label">
                    <label>General</label>
                    <frontend_type>text</frontend_type>
                    <sort_order>10</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>1</show_in_website>
                    <show_in_store>0</show_in_store>
                    <fields>
                        <enabled translate="label comment">
                            <label>Enabled</label>
                            <comment>Master switch. When disabled, no guest orders are linked by any trigger.</comment>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>10</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>0</show_in_store>
                        </enabled>
                    </fields>
                </general>

                <triggers translate="label">
                    <label>Triggers</label>
                    <frontend_type>text</frontend_type>
                    <sort_order>20</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>1</show_in_website>
                    <show_in_store>0</show_in_store>
                    <fields>
                        <on_order_place translate="label comment">
                            <label>Link On Order Placement</label>
                            <comment>When a guest places an order whose email matches a registered customer, link it automatically.</comment>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>10</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>0</show_in_store>
                        </on_order_place>
                        <on_customer_register translate="label comment">
                            <label>Link On Customer Registration</label>
                            <comment>When a new customer registers, link any pre-existing guest orders that match their email.</comment>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>20</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>0</show_in_store>
                        </on_customer_register>
                    </fields>
                </triggers>
                <create translate="label comment">
                    <label>Accounts For Guests</label>
                    <expanded>1</expanded>
                    <comment>Give everybody who orders as a guest a customer account, so their orders, addresses and history are in one place. The account is made quietly: no email is sent and the password is random (they sign in by resetting it). For guests who ordered before this was switched on, use the button below.</comment>
                    <frontend_type>text</frontend_type>
                    <sort_order>30</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>1</show_in_website>
                    <show_in_store>0</show_in_store>
                    <fields>
                        <enabled translate="label comment">
                            <label>Auto-Generate Account For New Emails</label>
                            <comment>When a guest order has no registered customer with the same email on its website, create one and link the order to it.</comment>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>10</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>0</show_in_store>
                        </enabled>
                        <on_order_place translate="label comment">
                            <label>Create As Each Guest Order Is Placed</label>
                            <comment>Yes: from now on, every guest order gets its account straight away. No: accounts are only made when the button below (or the shell script) is run.</comment>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>20</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>0</show_in_store>
                        </on_order_place>
                        <copy_addresses translate="label comment">
                            <label>Copy The Order Addresses</label>
                            <comment>Put the billing and shipping addresses of the order in the new account as its default addresses.</comment>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>30</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>0</show_in_store>
                        </copy_addresses>
                        <subscribe translate="label comment">
                            <label>Subscribe New Accounts To The Newsletter</label>
                            <comment>Yes: each account made here is also put on the newsletter list, without a confirmation email. Only addresses the newsletter has never seen: anybody already on the list, unsubscribed included, is left as they are. Only switch this on if your customers have agreed to marketing email by ordering.</comment>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>40</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>0</show_in_store>
                        </subscribe>
                        <apply translate="label comment">
                            <label>Existing Guest Orders</label>
                            <comment>Goes through every guest order already in the store, gives each guest with no account one, and links their orders to it, using the settings above as they were last saved. Safe to stop and run again: orders already linked are skipped.</comment>
                            <frontend_type>button</frontend_type>
                            <frontend_model>ysrtech_guesttocustomer/adminhtml_system_config_apply</frontend_model>
                            <sort_order>50</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </apply>
                    </fields>
                </create>
            </groups>
        </ysrtech_guesttocustomer>
    </sections>
</config>
